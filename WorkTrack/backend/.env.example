# Backend Environment Configuration
# Copy to .env and update with actual values

# Server Settings
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Security - REQUIRED
# Generate with: openssl rand -base64 32
JWT_SECRET=your-generated-jwt-secret-here-min-32-chars
SESSION_SECRET=your-generated-session-secret-here-min-32-chars
SQLITE_CIPHER_KEY=your-generated-cipher-key-here-min-32-chars

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OAuth/SAML (optional, for enterprise features)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SAML_ENTRY_POINT=https://your-idp.example.com/sso
SAML_CERT=your-saml-certificate-pem

# Optional: PostgreSQL (when migrating from SQLite)
DATABASE_URL=
REDIS_URL=

# Logging
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true
